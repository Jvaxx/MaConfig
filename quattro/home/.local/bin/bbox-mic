#!/usr/bin/env python3
"""Control the Bbox remote microphone bridge: bbox-mic {toggle|start|stop|status}."""
import os
import socket
import sys

RUNTIME = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
SOCKET_PATH = os.path.join(RUNTIME, 'bbox-mic.sock')

cmd = sys.argv[1] if len(sys.argv) > 1 else 'toggle'
if cmd in ('-h', '--help'):
    print(__doc__.strip())
    sys.exit(0)

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(12)
        s.connect(SOCKET_PATH)
        s.sendall(cmd.encode())
        print(s.recv(256).decode().strip())
except FileNotFoundError:
    sys.exit('bbox-mic-bridge is not running (systemctl --user start bbox-mic-bridge)')
except OSError as e:
    sys.exit(f'bbox-mic: {e}')
