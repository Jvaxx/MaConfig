# Fichiers/dossiers gérés sur l'hôte Fedora Asahi Remix (MacBook Pro M3 Pro, KDE).
# Chemins relatifs à $HOME. Lignes vides et commençant par # ignorées.
#
# Deux sources possibles par entrée :
#   .config/foo          -> ./home/.config/foo          (spécifique à cet hôte)
#   shared:.config/foo   -> ../shared/home/.config/foo  (partagé avec quattro)
#
# Règle de partage : tout ce qui référence le système de thèmes Omarchy
# (~/.local/state/omarchy/current/...) est forcément spécifique à l'hôte.

# --- Neovim (config vim.pack, identique sur les deux machines) ---
# Exige nvim >= 0.12 : fourni par les mises à jour Fedora 44 (RPM neovim).
shared:.config/nvim

# --- Environnement shell ---
# .bashrc/.bash_profile restent locaux et préservent les hooks NVM/.bashrc.d.
# Les overrides .bashrc.local/.bash_profile.local restent hors sauvegarde/Git.
.bashrc
.bash_profile
shared:.config/shell/path.bash
shared:.config/shell/envs.bash
shared:.config/shell/aliases.bash
shared:.config/shell/init.bash

# --- Outils CLI ---
shared:.config/tmux/tmux.conf
shared:.config/starship.toml
shared:.config/git/config
# btop : color_theme est "current" sur quattro (symlink Omarchy), figé sur
# gruvbox_material_dark ici. D'où la copie locale.
.config/btop/btop.conf

# --- Terminal ---
# foot uniquement : rendu CPU, donc utilisable sans accélération GPU sur M3.
# kitty/alacritty/ghostty exigent OpenGL et ne sont pas installés ici.
.config/foot/foot.ini

# --- Vidéo (sortie CPU Wayland; à revoir quand le GPU sera utilisable) ---
.config/mpv/mpv.conf

# --- Clavier ---
# Aucun layout XKB custom installé. Les réglages Plasma actuels sont conservés;
# vérifier disposition/variante et assigner une touche Compose si nécessaire.
# Le matériel Apple seul ne garantit pas le layout/les raccourcis de macOS.
#
# ~/.XCompose local (include "%L" au lieu du xcompose Omarchy), le contenu vient
# des deux fichiers partagés : emoji (copie du set Omarchy) + personal.
.XCompose
shared:.config/xcompose/emoji
shared:.config/xcompose/personal
