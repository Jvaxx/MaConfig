# Fedora Asahi Remix 44+ / aarch64. Lu par bootstrap.sh.
# Directives explicites: #@tier N, #@repo, #@copr propriétaire/projet.
# Un nom RPM par ligne. Les installations hors dépôts sont dans bootstrap.sh
# et assets.json; --tier filtre AUSSI ces installations.

# TIER 1 — shell, éditeur et CLI (pas de toolchains ni d'applications GUI)
#@tier 1
#@repo
bash-completion
bat
btop
direnv
eza
fd-find
fzf
git
gh
glow
gum
jq
less
man-db
plocate
ripgrep
tealdeer
tmux
unzip
zoxide
fastfetch
wl-clipboard
nmap-ncat
socat
whois
inxi
inotify-tools
xmlstarlet
qrencode
zbar
ImageMagick
yt-dlp
# Neovim >= 0.12 est disponible dans les mises à jour Fedora 44.
neovim
# Prérequis des scripts, des téléchargements et du pager man (col).
python3
curl
ca-certificates
tar
gzip
xz
util-linux
rsync
# Seul COPR: build Fedora/aarch64, avec chroot explicite dans bootstrap.sh.
#@copr atim/starship
starship
# Hors dépôts, même tier: lazygit (archive ARM64 vérifiée, pas le COPR abandonné).

# TIER 2 — développement, parsers Neovim et conteneurs
#@tier 2
#@repo
clang
clang-tools-extra
llvm
cmake
ninja-build
make
gcc
gcc-c++
bear
golang
python3
python3-pip
python3-virtualenv
pipx
lua
luarocks
# Fedora 44 utilise des paquets versionnés. Les -bin fournissent les commandes
# non suffixées node/npm; NVM existant reste prioritaire dans le shell.
nodejs24
nodejs24-bin
nodejs24-npm
nodejs24-npm-bin
rust
cargo
rust-analyzer
gopls
ruff
# Disponible dans Fedora 44: pas de compilation cargo nécessaire.
tree-sitter-cli
podman
podman-compose
podman-docker
# Hors dépôts, même tier: mise, uv, lazydocker, dua-cli, diskonaut.
# Le socket Podman pour lazydocker reste opt-in, voir RESTORE.md.

# TIER 3 — terminal, polices et saisie
#@tier 3
#@repo
foot
fontconfig
# Repli lisible même avec --skip-manual; pas les glyphes Nerd Font.
jetbrains-mono-fonts
google-noto-fonts-common
google-noto-sans-fonts
google-noto-serif-fonts
google-noto-sans-cjk-fonts
google-noto-color-emoji-fonts
# Hors dépôts, même tier: JetBrainsMono Nerd Font, archive officielle vérifiée.
# Aucun layout XKB personnalisé installé: les choix Plasma restent intacts.

# TIER 4 — applications GUI à tester en rendu logiciel (pas « sans GPU »)
#@tier 4
#@repo
flatpak
mpv
libreoffice-calc
libreoffice-writer
libreoffice-impress
xournalpp
ocrmypdf
tesseract
tesseract-langpack-eng
tesseract-langpack-fra
# Hors dépôts, même tier: LocalSend, Obsidian, Signal (Flatpaks --user).
# ARM64 disponible ne signifie pas performances/autonomie garanties sans GPU.
