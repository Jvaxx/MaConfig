# Chemins relatifs à $HOME, liés au dépôt ; shared: utilise ../shared/home.
# copy: conserve restore/sync par copie pour les fichiers réécrits par une app.
# Préfixes combinables : copy:shared:chemin.
# Liste explicite : jamais de clés, tokens, historiques ou profils navigateur.
.zshrc
.zprofile
.gitconfig
.config/ghostty
.config/skhd
.config/yabai
copy:.config/karabiner/karabiner.json
shared:.config/nvim
shared:.config/starship.toml
shared:.config/tmux/tmux.conf
