// French (Macintosh) for the MacBook Pro M3 Pro's built-in keyboard (ISO
// AZERTY), with two changes made on top of fr(mac):
//
//   1. Right Cmd and right Option are swapped. fr(mac) makes right Option
//      (<RALT>) AltGr through level3(ralt_switch) and leaves right Cmd
//      (<RWIN>) a Super key. Here right Cmd is AltGr and right Option is
//      Super. The left side is untouched: left Option = Alt, left Cmd = Super.
//
//      altwin:swap_ralt_rwin is NOT used: it turns <RWIN> into a plain Alt_R
//      in Mod1, which loses AltGr, and AltGr is the only way to @ # { } [ ] |
//      on this board's other keys. Each key's modifier is moved explicitly:
//      a key that sends ISO_Level3_Shift must not stay in Mod4, or AltGr would
//      also press Super and fire Hyprland's SUPER bindings.
//
//   2. The key under Escape and the key right of Left Shift are swapped back
//      to their printed labels. The kernel reports these two keys the wrong
//      way round on this keyboard (hid_apple iso_layout is on auto and does
//      not engage), so the key printed "@ #" sent <LSGT> and typed < > , and
//      the key printed "< >" sent <TLDE> and typed @ # .
//      This fixes the desktop session only: the console and the LUKS prompt
//      still see the kernel's order. If hid_apple.iso_layout is ever set in
//      /etc/modprobe.d instead, delete these two lines, or the keys swap twice.
//
// Selected in ~/.config/hypr/input.lua (kb_layout = "frmacbook").
// Check with:
//   xkbcli compile-keymap --layout frmacbook --options caps:escape_shifted_capslock

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {

    include "fr(mac)"

    name[Group1] = "French (Macintosh, MacBook Pro)";

    // 1. Right Option (<RALT>) -> Super, right Cmd (<RWIN>) -> AltGr.
    replace key <RALT> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ Super_R ] };
    replace key <RWIN> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ ISO_Level3_Shift ] };
    modifier_map Mod4 { <RALT> };
    modifier_map Mod5 { <RWIN> };

    // 2. fr(mac)'s <TLDE> and <LSGT> definitions, exchanged.
    replace key <TLDE> { [      less,    greater, lessthanequal, greaterthanequal ] };
    replace key <LSGT> { [        at, numbersign, periodcentered,       ydiaeresis ] };
};
