#!/usr/bin/env python3
"""Shader-based stand-in for hyprsunset (night light) on B.

appledrm has no CTM property, so the real hyprsunset only produces failed
atomic commits. This daemon serves hyprsunset's IPC socket with the same
text protocol (temperature / gamma / identity / reset / profile) and applies
the tint through Hyprland's decoration.screen_shader instead. Every Omarchy
caller (bar indicator, SUPER+CTRL+N, menu, omarchy-toggle-nightlight) talks
to `hyprctl hyprsunset ...` and `pgrep -x hyprsunset`, so they keep working.

The file is named `hyprsunset` on purpose: the kernel sets comm from it, so
Omarchy's `pgrep -x hyprsunset || launch hyprsunset` sees this daemon and does
not start the real one. Any real /usr/bin/hyprsunset of this user is stopped.

Test knobs (environment):
  NLS_SOCKET=<path>  serve this socket instead of the Hyprland instance one
  NLS_DRYRUN=1       log the hyprctl eval instead of running it; no socket2
  NLS_NO_KILL=1      leave real hyprsunset processes alone
"""

import ctypes
import math
import os
import selectors
import signal
import socket
import subprocess
import sys
import time

REAL_HYPRSUNSET = "/usr/bin/hyprsunset"
OFF_TEMPERATURE = 6500  # sRGB white (D65); maps to "no shader"
MIN_TEMPERATURE, MAX_TEMPERATURE = 1000, 20000
MAX_GAMMA = 200

DRYRUN = os.environ.get("NLS_DRYRUN") == "1"
# Scales the tint without changing the temperatures callers set and read back
# (Omarchy hardcodes 4000 K): 1.0 = plain blackbody, 1.2 = 20 % deeper.
STRENGTH = min(max(float(os.environ.get("NLS_STRENGTH", "1.0")), 0.0), 2.0)


def log(msg):
    print(f"nightlight-shader: {msg}", file=sys.stderr, flush=True)


def set_comm(name):
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        libc.prctl(15, ctypes.c_char_p(name.encode()), 0, 0, 0)  # PR_SET_NAME
    except OSError:
        pass


def hypr_dir():
    runtime = os.environ["XDG_RUNTIME_DIR"]
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        base = os.path.join(runtime, "hypr")
        dirs = sorted(os.listdir(base), key=lambda d: os.path.getmtime(os.path.join(base, d)))
        if not dirs:
            raise SystemExit("no Hyprland instance found")
        sig = dirs[-1]
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
    return os.path.join(runtime, "hypr", sig)


# Tanner Helland's blackbody approximation, the same family hyprsunset uses.
def blackbody(kelvin):
    t = kelvin / 100.0
    if t <= 66:
        r = 255.0
        g = 99.4708025861 * math.log(t) - 161.1195681661
    else:
        r = 329.698727446 * (t - 60) ** -0.1332047592
        g = 288.1221695283 * (t - 60) ** -0.0755148492
    if t >= 66:
        b = 255.0
    elif t <= 19:
        b = 0.0
    else:
        b = 138.5177312231 * math.log(t - 10) - 305.0447927307
    return [min(max(c, 0.0), 255.0) / 255.0 for c in (r, g, b)]


def multipliers(temperature, gamma):
    """RGB factors relative to 6500 K, so 6500 K at 100 % is exactly white."""
    ref = blackbody(OFF_TEMPERATURE)
    rgb = [min(c / w, 1.0) for c, w in zip(blackbody(temperature), ref)]
    rgb = [max(1.0 - STRENGTH * (1.0 - c), 0.0) for c in rgb]
    return [c * gamma / 100.0 for c in rgb]


SHADER = """#version 300 es
// Generated by nightlight-shader: {temperature} K, gamma {gamma} %, strength {strength:g}
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {{
    vec4 c = texture(tex, v_texcoord);
    fragColor = vec4(min(c.rgb * vec3({r:.6f}, {g:.6f}, {b:.6f}), 1.0), c.a);
}}
"""


class NightLight:
    def __init__(self, shader_dir):
        self.shader_dir = shader_dir
        self.temperature = OFF_TEMPERATURE
        self.gamma = 100
        self.identity = True
        self.applied = None

    def shader_path(self):
        if self.identity:
            return ""
        rgb = multipliers(self.temperature, self.gamma)
        if all(abs(c - 1.0) < 1e-4 for c in rgb):
            return ""
        suffix = "" if STRENGTH == 1.0 else f"-s{STRENGTH:g}"
        path = os.path.join(self.shader_dir, f"nightlight-{self.temperature}k-{self.gamma}{suffix}.frag")
        if not os.path.exists(path):
            tmp = path + ".tmp"
            with open(tmp, "w") as f:
                f.write(SHADER.format(temperature=self.temperature, gamma=self.gamma,
                                      strength=STRENGTH, r=rgb[0], g=rgb[1], b=rgb[2]))
            os.replace(tmp, path)
        return path

    def apply(self, force=False):
        path = self.shader_path()
        if path == self.applied and not force:
            return
        code = 'hl.config({ decoration = { screen_shader = "%s" } })' % path
        if DRYRUN:
            log(f"eval {code}")
        else:
            res = subprocess.run(["hyprctl", "eval", code], capture_output=True, text=True, timeout=5)
            if res.returncode != 0 or res.stdout.strip() != "ok":
                log(f"hyprctl eval failed: {res.stdout.strip()} {res.stderr.strip()}")
                return
        self.applied = path
        for name in os.listdir(self.shader_dir):
            old = os.path.join(self.shader_dir, name)
            if old != path and name.startswith("nightlight-"):
                os.unlink(old)

    # Replies mirror hyprsunset 0.4.0's text protocol.
    def handle(self, request):
        words = request.split()
        if not words:
            return "invalid command"
        cmd, args = words[0], words[1:]

        if cmd == "temperature":
            if not args:
                return str(self.temperature)
            value = self.relative(args[0], self.temperature)
            if value is None or not MIN_TEMPERATURE <= value <= MAX_TEMPERATURE:
                return "Invalid temperature (should be an integer in range 1000-20000)"
            self.temperature, self.identity = value, False
        elif cmd == "gamma":
            if not args:
                return str(self.gamma)
            value = self.relative(args[0], self.gamma)
            if value is None or not 0 <= value <= MAX_GAMMA:
                return f"Invalid gamma value (should be in range 0-{MAX_GAMMA}%)"
            self.gamma = value
        elif cmd == "identity":
            if args and args[0] not in ("true", "false"):
                return "Invalid identity value (should be true or false)"
            self.identity = not args or args[0] == "true"
        elif cmd == "reset":
            what = args[0] if args else ""
            if what == "temperature":
                self.temperature = OFF_TEMPERATURE
            elif what == "gamma":
                self.gamma = 100
            elif what == "identity":
                self.identity = True
            else:
                return "Invalid reset value (should be either temperature, gamma or identity)"
        elif cmd == "profile":
            return (f"Time: --:--\nTemperature: {self.temperature}\n"
                    f"Gamma: {self.gamma / 100:g}\nIdentity: {str(self.identity).lower()}")
        else:
            return "invalid command"

        self.apply()
        return "ok"

    @staticmethod
    def relative(arg, current):
        try:
            if arg[0] in "+-":
                return current + int(arg)
            return int(arg)
        except (ValueError, IndexError):
            return None


def stop_real_hyprsunset():
    uid = os.getuid()
    victims = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if os.stat(f"/proc/{pid}").st_uid == uid and os.readlink(f"/proc/{pid}/exe") == REAL_HYPRSUNSET:
                os.kill(int(pid), signal.SIGTERM)
                victims.append(int(pid))
        except OSError:
            pass
    deadline = time.monotonic() + 2
    while victims and time.monotonic() < deadline:
        victims = [p for p in victims if os.path.exists(f"/proc/{p}")]
        time.sleep(0.05)
    for pid in victims:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    return victims


def main():
    set_comm("hyprsunset")
    if os.environ.get("NLS_SOCKET"):
        sock_path = os.environ["NLS_SOCKET"]
        shader_dir = os.path.join(os.path.dirname(sock_path), "nightlight-shader")
    else:
        sock_path = os.path.join(hypr_dir(), ".hyprsunset.sock")
        shader_dir = os.path.join(os.environ["XDG_RUNTIME_DIR"], "nightlight-shader")
    os.makedirs(shader_dir, exist_ok=True)

    no_kill = os.environ.get("NLS_NO_KILL") == "1"
    if not no_kill:
        stop_real_hyprsunset()

    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(sock_path)
    server.listen(8)
    server_ino = os.stat(sock_path).st_ino

    light = NightLight(shader_dir)
    light.apply(force=True)  # clear any shader a previous instance left behind

    sel = selectors.DefaultSelector()
    sel.register(server, selectors.EVENT_READ, "ipc")
    if not DRYRUN:
        events = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        events.connect(os.path.join(hypr_dir(), ".socket2.sock"))
        sel.register(events, selectors.EVENT_READ, "events")
    pending_events = b""

    stopping = False

    def stop(*_):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    log(f"serving {sock_path}")

    # One late sweep catches a real hyprsunset launched while we were starting.
    recheck_at = time.monotonic() + 3
    while not stopping:
        timeout = max(0.0, recheck_at - time.monotonic()) if recheck_at else None
        for key, _ in sel.select(timeout):
            if key.data == "ipc":
                conn, _ = server.accept()
                with conn:
                    conn.settimeout(1)
                    try:
                        request = conn.recv(4096).decode(errors="replace").strip()
                        conn.sendall(light.handle(request).encode())
                    except OSError as e:
                        log(f"ipc error: {e}")
            else:
                chunk = key.fileobj.recv(65536)
                if not chunk:
                    log("Hyprland event socket closed; exiting")
                    stopping = True
                    break
                pending_events += chunk
                *lines, pending_events = pending_events.split(b"\n")
                if any(line.startswith(b"configreloaded>>") for line in lines):
                    light.apply(force=True)
        if recheck_at and time.monotonic() >= recheck_at:
            recheck_at = None
            if not no_kill and stop_real_hyprsunset():
                log("stopped a late real hyprsunset")
            try:
                if os.stat(sock_path).st_ino != server_ino:
                    raise FileNotFoundError
            except FileNotFoundError:
                log("socket was replaced; exiting for a clean restart")
                stopping = True

    if light.applied:
        light.identity = True
        light.apply()
    try:
        if os.stat(sock_path).st_ino == server_ino:
            os.unlink(sock_path)
    except FileNotFoundError:
        pass


if __name__ == "__main__":
    main()
